{
  "manifest_version": 3,
  "name": "Tabcat",
  "version": "0.1.0",
  "description": "Sorts your tabs into groups automatically, on your computer.",
  "icons": {
    "48": "icons/tabcat.svg",
    "96": "icons/tabcat.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabcat@cwsr.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "browsingActivity",
          "websiteContent"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Tabcat",
    "default_icon": "icons/tabcat.svg",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "optional_permissions": [
    "trialML"
  ]
}
