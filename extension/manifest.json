{
  "manifest_version": 3,
  "name": "Tabcat",
  "version": "0.2.0",
  "description": "Sorts your tabs into groups automatically, on your computer.",
  "icons": {
    "16": "icons/tabcat-16.png",
    "32": "icons/tabcat-32.png",
    "48": "icons/tabcat-48.png",
    "96": "icons/tabcat-96.png",
    "128": "icons/tabcat-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabcat@cwsr.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "browsingActivity",
          "websiteContent"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Tabcat",
    "default_icon": {
      "16": "icons/tabcat-16.png",
      "32": "icons/tabcat-32.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "commands": {
    "show-last-move": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Show the last tab Tabcat moved"
    }
  }
}
