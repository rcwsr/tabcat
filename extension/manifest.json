{
  "manifest_version": 3,
  "name": "Taby",
  "version": "0.1.0",
  "description": "Sorts your tabs into groups using a typed decision model.",
  "browser_specific_settings": {
    "gecko": {
      "id": "taby@cwsr.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Taby",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
