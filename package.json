{
  "name": "tabcat",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Firefox extension that sorts open tabs into tab groups",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/vendor.mjs",
    "lint": "web-ext lint -s extension",
    "start": "web-ext run -s extension",
    "build": "node scripts/vendor.mjs && web-ext build -s extension --overwrite-dest",
    "test": "node --test 'test/unit/*.test.mjs'",
    "test:model": "node --test 'test/model/*.test.mjs'",
    "test:browser": "node --test --test-concurrency=1 'test/browser/*.test.mjs'",
    "test:all": "npm test && npm run test:model && npm run test:browser",
    "eval": "node scripts/eval.mjs"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.0",
    "puppeteer-core": "25.12.0",
    "web-ext": "10.7.0"
  }
}
